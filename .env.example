# Copy to .env (git-ignored) and fill in. Then run scripts/config-gen.py and scripts/seed-gen.py.

# Supabase → Project Settings → API Keys. Only the publishable key, never the secret one.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The two demo accounts created by supabase/seed.sql (generated, git-ignored).
DEMO_CLINICIAN_EMAIL=therapist@carehold.demo
DEMO_CLINICIAN_PASSWORD=
DEMO_PATIENT_EMAIL=patient@carehold.demo
DEMO_PATIENT_PASSWORD=
